---
import Base from '../layouts/Base.astro';
import AboutGraph from '../components/AboutGraph.astro';
import Icon from '../components/Icon.astro';
import { profile, about } from '../data/profile';
---
<Base section="about">
  <!-- Old WordPress links were hash routes (/#resume); forward them to the real pages. -->
  <script is:inline>
    const legacy = { '#resume': '/resume/', '#portfolio': '/portfolio/', '#posts': '/blog/', '#contact': '/contact/' };
    if (legacy[location.hash]) location.replace(legacy[location.hash]);
  </script>
  <section class="hero">
    <div class="art"><AboutGraph /></div>
    <div class="intro">
      <h1>{profile.role}</h1>
      {about.intro.map((p) => <p>{p}</p>)}
      <ul class="current">
        {about.current.map((c) => (
          <li>
            <a href={c.href}><strong>{c.name}</strong></a>, {c.text}
          </li>
        ))}
      </ul>
      <div class="actions">
        <a class="button" href="/contact/">
          <span class="with-icon">Get in touch <Icon name="arrow-right" size={16} /></span>
        </a>
        <a class="cv with-icon" href={profile.cv} download><Icon name="download" size={16} /> Download my CV</a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* Three rows: the middle one is as tall as the intro, and the outer two share
     the leftover screen so the block sits just above centre (optical centre).
     The graph fills the middle row exactly, so its first and last nodes line up
     with the headline and the CV button; the dotted panel spans all three. */
  .hero {
    --edge: 2.5rem;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-rows: 1fr auto 1.4fr;
    min-height: 100dvh;
  }
  .hero::before {
    content: '';
    grid-area: 1 / 1 / -1 / 2;
    background: radial-gradient(circle, #dcdcd8 1px, transparent 1.2px) 0 0 / 16px 16px, var(--tint);
    border-right: 1px solid var(--rule);
  }
  .art { grid-area: 2 / 1; position: relative; }
  /* Absolute, so the graph takes the intro's height rather than adding to it. */
  .art :global(svg) { position: absolute; inset: var(--edge) 2rem; height: calc(100% - 2 * var(--edge)); max-width: 30rem; margin-inline: auto; }
  .intro { grid-area: 2 / 2; max-width: 44rem; padding: var(--edge) var(--gutter); }
  /* Pull the line box up by its leading so the capitals, not the box, sit on the top line. */
  h1 { font-size: var(--step-4); line-height: 1.1; margin: -0.17em 0 1.5rem; letter-spacing: -0.01em; }
  .current { list-style: none; margin: 0 0 2rem; padding: 0; }
  .current li { margin-bottom: 0.9rem; padding-left: 1rem; border-left: 2px solid var(--rule); }
  .current strong { color: var(--ink); font-weight: 600; }
  .current a { text-decoration: none; }
  .current a strong { color: var(--accent-text); }
  .with-icon { display: inline-flex; align-items: center; gap: 0.5rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.75rem; }
  .cv { color: var(--accent-text); font-size: var(--step--1); font-weight: 500; text-decoration: none; }
  .cv:hover { text-decoration: underline; text-underline-offset: 0.2em; }


  @media (max-width: 75rem) {
    .hero { grid-template-columns: 1fr; grid-template-rows: auto; min-height: 0; }
    .hero::before { display: none; }
    /* Headline first on small screens; the graph follows as illustration. */
    .intro { grid-area: 1 / 1; padding: 2rem var(--gutter) 2.5rem; }
    .art {
      grid-area: 2 / 1;
      padding: 2rem 1rem;
      background: radial-gradient(circle, #dcdcd8 1px, transparent 1.2px) 0 0 / 16px 16px, var(--tint);
      border-top: 1px solid var(--rule);
    }
    .art :global(svg) { position: static; display: block; height: auto; max-width: 26rem; margin-inline: auto; }
  }
</style>
