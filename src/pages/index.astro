---
import Base from '../layouts/Base.astro';
import AboutGraph from '../components/AboutGraph.astro';
import Icon from '../components/Icon.astro';
import { profile, about } from '../data/profile';
---
<Base section="about">
  <!-- Old WordPress links were hash routes (/#resume); forward them to the real pages. -->
  <script is:inline>
    const legacy = { '#resume': '/resume/', '#portfolio': '/portfolio/', '#posts': '/blog/', '#contact': '/contact/' };
    if (legacy[location.hash]) location.replace(legacy[location.hash]);
  </script>
  <section class="hero">
    <div class="art"><AboutGraph /></div>
    <div class="intro">
      <h1>{profile.role}</h1>
      {about.intro.map((p) => <p>{p}</p>)}
      <ul class="current">
        {about.current.map((c) => (
          <li>
            {'href' in c ? <a href={c.href}><strong>{c.name}</strong></a> : <strong>{c.name}</strong>}
            {c.text.startsWith('(') ? ' ' : ', '}{c.text}
          </li>
        ))}
      </ul>
      <a class="button" href={profile.cv} download>
        <span class="with-icon"><Icon name="download" size={16} /> Download my CV</span>
      </a>
    </div>
  </section>

  <section class="services">
    <h2 class="block-title">What I do</h2>
    <ul>
      {about.services.map((s) => (
        <li>
          <Icon name={s.icon} size={26} class="service-icon" />
          <div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    min-height: min(100dvh, 56rem);
    border-bottom: 1px solid var(--rule);
  }
  .art {
    display: grid;
    place-items: center;
    padding: 3rem 2rem;
    background: radial-gradient(circle, #dcdcd8 1px, transparent 1.2px) 0 0 / 16px 16px, var(--tint);
    border-right: 1px solid var(--rule);
  }
  .art :global(svg) { max-width: 30rem; max-height: 44rem; }
  .intro { align-self: center; max-width: 38rem; padding: 4rem var(--gutter); }
  h1 { font-size: var(--step-4); line-height: 1.1; margin-bottom: 1.5rem; letter-spacing: -0.01em; }
  .current { list-style: none; margin: 0 0 2rem; padding: 0; }
  .current li { margin-bottom: 0.9rem; padding-left: 1rem; border-left: 2px solid var(--rule); }
  .current strong { color: var(--ink); font-weight: 600; }
  .current a { text-decoration: none; }
  .current a strong { color: var(--accent-text); }
  .with-icon { display: inline-flex; align-items: center; gap: 0.5rem; }

  .services { max-width: var(--content); padding: 3.5rem var(--gutter) 5rem; }
  .services ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 2rem 3rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .services li { display: grid; grid-template-columns: auto 1fr; gap: 1.1rem; }
  .services :global(.service-icon) { color: var(--accent); margin-top: 0.15rem; }
  .services h3 { font-size: var(--step-1); margin-bottom: 0.3rem; }
  .services p { margin: 0; font-size: 0.875rem; }

  @media (max-width: 75rem) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    /* Headline first on small screens; the graph follows as illustration. */
    .art { order: 2; border-right: 0; border-top: 1px solid var(--rule); padding: 2rem 1rem; }
    .art :global(svg) { max-height: 24rem; }
    .intro { padding: 2.5rem var(--gutter) 3rem; }
  }
</style>
