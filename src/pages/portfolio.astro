---
import Base from '../layouts/Base.astro';
import PageShell from '../components/PageShell.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const lead = 'Selected projects in analytics, data visualisation and product strategy.';
---
<Base title="Portfolio" section="portfolio" description={lead}>
  <PageShell title="Portfolio" {lead}>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </PageShell>
</Base>

<style>
  /* Fixed column counts (not auto-fill) so a row of projects always spans the full width. */
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  @media (max-width: 75rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .grid { grid-template-columns: 1fr; } }
</style>
