---
// Shared layout for blog posts and project write-ups.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from './Base.astro';
import CausalMotif from '../components/CausalMotif.astro';
import Icon from '../components/Icon.astro';
import { formatDate } from '../lib/content';
import type { Section } from '../data/site';

interface Props {
  section: Section;
  seed: string;
  transitionName: string;
  title: string;
  description: string;
  pubDate: Date;
  categories: string[];
  cover?: ImageMetadata;
  minutes?: number;
  link?: string;
  back: { href: string; label: string };
}
const { section, seed, transitionName, title, description, pubDate, categories, cover, minutes, link, back } = Astro.props;
const ogImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
// Portrait covers (e.g. a book) are shown whole and upright instead of cropped into the wide banner.
const portrait = cover ? cover.height > cover.width : false;
const morph = `view-transition-name:${transitionName}; view-transition-class: morph`;
---
<Base title={title} description={description} section={section} image={ogImage} type="article">
  <article>
    <div class:list={['banner', { portrait }]}>
      {cover && portrait && <Image src={cover} alt="" widths={[380, 760, 1140]} sizes="380px" loading="eager" style={morph} />}
      {cover && !portrait && <Image src={cover} alt="" widths={[800, 1200, 1800]} sizes="(max-width: 60rem) 100vw, 75vw" loading="eager" style={morph} />}
      {!cover && <CausalMotif seed={seed} width={1600} height={450} transitionName={transitionName} />}
    </div>
    <div class="inner">
      <header>
        <a class="back" href={back.href}><Icon name="arrow-left" size={14} /> {back.label}</a>
        <h1>{title}</h1>
        <p class="meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {minutes && <>, {minutes} min read</>}
          {categories.length > 0 && <> in {categories.join(', ')}</>}
        </p>
        {link && (
          <a class="button live" href={link} target="_blank" rel="noopener">
            <span>Visit the live project</span> <Icon name="external" size={14} />
          </a>
        )}
      </header>
      <div class="prose">
        <slot />
      </div>
      <slot name="after" />
    </div>
  </article>
</Base>

<style>
  .banner { aspect-ratio: 32 / 9; overflow: hidden; background: var(--tint); border-bottom: 1px solid var(--rule); }
  .banner :global(img), .banner :global(svg) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .banner.portrait {
    aspect-ratio: auto;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 4vw, 3rem) 1rem;
    background: radial-gradient(circle, #dcdcd8 1px, transparent 1.2px) 0 0 / 16px 16px, var(--tint);
  }
  .banner.portrait :global(img) {
    width: auto;
    height: clamp(16rem, 42vh, 30rem);
    object-fit: contain;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 12px 32px rgb(0 0 0 / 0.14);
  }
  .inner { padding: 2.5rem var(--gutter) 5rem; }
  /* Centre the reading column (and anything after it) in the content area. */
  .inner > :global(*) { max-width: var(--measure); margin-inline: auto; }
  .inner > :global(aside) { max-width: 60rem; } /* related-posts grid needs more room */
  header { margin-bottom: 2.5rem; }
  .back { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--muted); font-size: var(--step--1); text-decoration: none; }
  .back:hover { color: var(--accent-text); }
  h1 { margin: 1rem 0 0.75rem; font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem); line-height: 1.2; letter-spacing: -0.01em; }
  .meta { margin: 0; }
  .live { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; }
  @media (max-width: 40rem) { .banner { aspect-ratio: 16 / 7; } }
</style>
