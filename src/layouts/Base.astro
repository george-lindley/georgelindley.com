---
import { Font } from 'astro:assets';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { nav, goatcounter, googleSiteVerification, type Section } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  section?: Section;
  /** Absolute or root-relative URL of a social preview image. */
  image?: string;
  type?: 'website' | 'article';
}
const { title, description = profile.description, section, image = '/og/site/default.png', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Previous/next arrows cycle through the main sections, like the original theme.
const i = nav.findIndex((n) => n.id === section);
const isSectionIndex = i >= 0 && Astro.url.pathname === nav[i].href;
const prev = nav[(i - 1 + nav.length) % nav.length];
const next = nav[(i + 1) % nav.length];

// Prerender same-site pages on hover (native Speculation Rules; ignored by browsers without support).
const speculation = JSON.stringify({
  prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
});
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}: Blog`} href="/rss.xml" />
    <meta name="theme-color" content="#ffffff" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-poppins" preload={[{ weight: 400, style: 'normal' }, { weight: 600, style: 'normal' }]} />
    <script type="speculationrules" is:inline set:html={speculation} />
    {import.meta.env.PROD && goatcounter && (
      <script is:inline async data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js" />
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Sidebar section={section} />
    <main id="main" class="content">
      <slot />
    </main>
    {isSectionIndex && (
      <nav class="section-arrows" aria-label="Sections">
        <a href={prev.href} aria-label={`Previous: ${prev.label}`}><Icon name="arrow-left" /></a>
        <a href={next.href} aria-label={`Next: ${next.label}`}><Icon name="arrow-right" /></a>
      </nav>
    )}
  </body>
</html>

<style>
  .content {
    margin-left: var(--sidebar);
    min-height: 100dvh;
    background: var(--paper);
    border-left: 1px solid var(--rule);
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 20;
    padding: 0.5rem 1rem;
    background: var(--ink);
    color: #fff;
  }
  .skip:focus { top: 1rem; }
  .section-arrows {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    gap: 0.25rem;
    z-index: 5;
    view-transition-name: arrows;
  }
  .section-arrows a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--muted);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.06);
    transition: color 0.2s, box-shadow 0.2s;
  }
  .section-arrows a:hover { color: var(--ink); box-shadow: 0 4px 18px rgb(0 0 0 / 0.1); }
  @media (max-width: 60rem) {
    .content { margin-left: 0; border-left: 0; }
    .section-arrows { display: none; }
  }
</style>
