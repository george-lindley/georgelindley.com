---
// Draws a labelled causal graph: pills joined by arrows, the highlighted path in
// accent. Edges draw themselves in once on load (CSS only). Layout is the
// caller's job (see lib/graph.ts); this only renders.
import { pill, clip, type GraphNode, type GraphEdge, type Point } from '../lib/graph';

interface Props {
  nodes: GraphNode[];
  edges: GraphEdge[];
  /** Node ids of the highlighted chain, cause first. */
  path: string[];
  /** Accessible description of what the graph says. */
  title: string;
  /** Optional curve control points, keyed "from>to"; other edges are straight. */
  controls?: Record<string, Point>;
  viewBox: string;
  preserveAspectRatio?: string;
  class?: string;
  transitionName?: string;
}
const { nodes, edges, path, controls = {}, title, viewBox, preserveAspectRatio, class: className, transitionName } = Astro.props;

const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const hot = new Set(path);
const onPath = (from: string, to: string) => path.some((id, i) => id === from && path[i + 1] === to);
const lines = edges.map(([from, to], i) => ({ ...clip(byId[from], byId[to], controls[`${from}>${to}`]), hot: onPath(from, to), i }));
const style = transitionName ? `view-transition-name: ${transitionName}; view-transition-class: morph` : undefined;
---
<svg class:list={['graph', className]} viewBox={viewBox} preserveAspectRatio={preserveAspectRatio} role="img" aria-label={title} style={style}>
  {lines.map((l) => (
    <g class:list={['edge', { hot: l.hot }]} style={`--i:${l.i}`}>
      <path class="stroke" d={`M${l.x1} ${l.y1}Q${l.cx} ${l.cy} ${l.x2} ${l.y2}`} pathLength="1" />
      <path class="head" d="M0 -5 9 0 0 5z" transform={`translate(${l.x2} ${l.y2}) rotate(${l.angle})`} />
    </g>
  ))}

  {nodes.map((n, i) => {
    const { hw, hh } = pill(n.label);
    return (
      <g class:list={['node', { hot: hot.has(n.id) }]} style={`--i:${i}`}>
        <rect x={n.x - hw} y={n.y - hh} width={hw * 2} height={hh * 2} rx={hh} />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.label}</text>
      </g>
    );
  })}
</svg>

<style>
  .graph { font-family: var(--font); --pale: color-mix(in srgb, var(--accent) 55%, var(--paper)); }
  .edge .stroke { fill: none; stroke: #c4c4bf; stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 0.7s var(--ease) forwards; animation-delay: calc(0.35s + var(--i) * 0.14s); }
  .edge .head { fill: #c4c4bf; opacity: 0; animation: fade 0.2s linear forwards; animation-delay: calc(0.95s + var(--i) * 0.14s); }
  .edge.hot .stroke { stroke: var(--pale); stroke-width: 2.25; }
  .edge.hot .head { fill: var(--pale); }
  .node { opacity: 0; animation: pop 0.5s var(--ease) forwards; animation-delay: calc(var(--i) * 0.08s); transform-box: fill-box; transform-origin: center; }
  .node rect { fill: var(--paper); stroke: #c4c4bf; stroke-width: 1.25; }
  .node text { fill: var(--ink); font-size: 13px; font-weight: 500; }
  /* A pale tint, not the solid orange of buttons, so nodes don't look clickable.
     Arrows on the path share the outline's tint; the thicker stroke carries the path. */
  .node.hot rect { fill: color-mix(in srgb, var(--accent) 22%, var(--paper)); stroke: var(--pale); }
  /* Inside a .graph-host, hovering redraws the arrows. Swapping to an identical
     keyframes name is what restarts a CSS animation; it replays on leave too. */
  :global(.graph-host:hover) .edge .stroke { animation-name: redraw; animation-delay: calc(var(--i) * 0.1s); }
  :global(.graph-host:hover) .edge .head { animation-name: refade; animation-delay: calc(0.6s + var(--i) * 0.1s); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes redraw { to { stroke-dashoffset: 0; } }
  @keyframes refade { to { opacity: 1; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes pop { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: none; } }
</style>
