---
// A small causal graph (DAG) drawn from a seed string. The same seed always
// produces the same graph, so every post gets a unique cover with no image file.
interface Props {
  seed: string;
  /** Aspect of the drawing; the SVG scales to its container width. */
  width?: number;
  height?: number;
  class?: string;
  /** Optional view-transition-name so the cover can morph between pages. */
  transitionName?: string;
}
const { seed, width = 800, height = 400, class: className, transitionName } = Astro.props;

// FNV-1a hash -> mulberry32 PRNG: tiny, fast, deterministic.
function hash(s: string) {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
  return h >>> 0;
}
function mulberry32(a: number) {
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const id = hash(seed).toString(36);
const rand = mulberry32(hash(seed));
const pick = <T,>(xs: T[]) => xs[Math.floor(rand() * xs.length)];

// Layered layout: causes on the left, outcome on the right.
const counts = [pick([1, 2]), pick([2, 3]), pick([2, 3]), 1];
const padX = width * 0.13, padY = height * 0.2;
type Node = { x: number; y: number; layer: number };
const layers: Node[][] = counts.map((n, layer) => {
  const x = padX + (layer * (width - 2 * padX)) / (counts.length - 1);
  return Array.from({ length: n }, (_, i) => {
    const slot = (i + 0.5) / n;
    const jitter = n > 1 ? (rand() - 0.5) * (0.35 / n) : (rand() - 0.5) * 0.3;
    return { x: x + (rand() - 0.5) * width * 0.04, y: padY + (slot + jitter) * (height - 2 * padY), layer };
  });
});

// Edges: every node feeds the next layer; every next-layer node has a parent.
const edges: [Node, Node][] = [];
for (let l = 0; l < layers.length - 1; l++) {
  const next = layers[l + 1];
  for (const a of layers[l]) {
    const targets = new Set([pick(next)]);
    if (next.length > 1 && rand() < 0.45) targets.add(pick(next));
    targets.forEach((b) => edges.push([a, b]));
  }
  for (const b of next) if (!edges.some(([, t]) => t === b)) edges.push([pick(layers[l]), b]);
}
// One "confounder-style" skip edge for texture.
if (rand() < 0.7) edges.push([pick(layers[0]), pick(layers[2])]);

// Highlight one causal path from a root to the outcome.
const path = new Set<Node>();
let cur = pick(layers[0]);
path.add(cur);
while (cur.layer < layers.length - 1) {
  const outs = edges.filter(([a, b]) => a === cur && b.layer === cur.layer + 1).map(([, b]) => b);
  cur = pick(outs);
  path.add(cur);
}
const onPath = ([a, b]: [Node, Node]) => path.has(a) && path.has(b) && b.layer === a.layer + 1;

const r = height * 0.03;
const thin = height / 200, thick = height / 125;
function segment([a, b]: [Node, Node]) {
  const dx = b.x - a.x, dy = b.y - a.y, len = Math.hypot(dx, dy);
  const ux = dx / len, uy = dy / len;
  const s = r + 3, e = r + 7;
  return { x1: a.x + ux * s, y1: a.y + uy * s, x2: b.x - ux * e, y2: b.y - uy * e };
}
const nodes = layers.flat();
const dot = Math.max(width, height) / 40;
---
<svg
  class:list={['motif', className]}
  viewBox={`0 0 ${width} ${height}`}
  role="img"
  aria-label="Decorative causal graph"
  style={transitionName ? `view-transition-name: ${transitionName}; view-transition-class: morph` : undefined}
>
  <defs>
    <pattern id={`g-${id}`} width={dot} height={dot} patternUnits="userSpaceOnUse">
      <circle cx={dot / 2} cy={dot / 2} r={dot * 0.06} fill="#d9d9d6" />
    </pattern>
    <marker id={`a-${id}`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
      <path d="M0 0 10 5 0 10z" fill="#bdbdb9" />
    </marker>
    <marker id={`h-${id}`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
      <path d="M0 0 10 5 0 10z" fill="var(--accent)" />
    </marker>
  </defs>
  <rect width={width} height={height} fill="var(--tint)" />
  <rect width={width} height={height} fill={`url(#g-${id})`} />
  {edges.filter((e) => !onPath(e)).map((e) => (
    <line {...segment(e)} stroke="#c9c9c5" stroke-width={thin} marker-end={`url(#a-${id})`} />
  ))}
  {edges.filter(onPath).map((e) => (
    <line {...segment(e)} stroke="var(--accent)" stroke-width={thick} marker-end={`url(#h-${id})`} />
  ))}
  {nodes.map((n) => (
    <circle
      cx={n.x} cy={n.y} r={r}
      fill={path.has(n) ? 'var(--accent)' : 'var(--paper)'}
      stroke={path.has(n) ? 'var(--accent)' : '#bdbdb9'}
      stroke-width={thin}
    />
  ))}
</svg>

<style>
  .motif { width: 100%; height: auto; display: block; }
</style>
