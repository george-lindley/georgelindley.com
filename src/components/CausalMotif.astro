---
// On-page causal-graph cover. The drawing itself lives in lib/motif.ts, shared
// with the build-time social-preview images so both always match.
import { motifSvg } from '../lib/motif';

interface Props {
  seed: string;
  /** Aspect of the drawing; the SVG scales to its container width. */
  width?: number;
  height?: number;
  class?: string;
  /** Optional view-transition-name so the cover can morph between pages. */
  transitionName?: string;
}
const { seed, width = 800, height = 400, class: className, transitionName } = Astro.props;

const svg = motifSvg({
  seed,
  width,
  height,
  attrs: {
    class: ['motif', className].filter(Boolean).join(' '),
    role: 'img',
    'aria-label': 'Decorative causal graph',
    style: transitionName ? `view-transition-name: ${transitionName}; view-transition-class: morph` : undefined,
  },
});
---
<Fragment set:html={svg} />

<style is:global>
  svg.motif { width: 100%; height: auto; display: block; }
</style>
