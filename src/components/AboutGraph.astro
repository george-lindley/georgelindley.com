---
// The About hero: a labelled causal graph of what George works on, placed by hand.
import Graph from './Graph.astro';
import { pill, type GraphNode, type GraphEdge } from '../lib/graph';

const W = 480;
const nodes: GraphNode[] = [
  { id: 'edu', label: 'Education data', x: 130, y: 90 },
  { id: 'labour', label: 'Labour-market signals', x: 330, y: 177 },
  { id: 'analytics', label: 'Analytics', x: 200, y: 337 },
  { id: 'sector', label: 'Sector insight', x: 360, y: 467 },
  { id: 'genai', label: 'GenAI products', x: 170, y: 569 },
  { id: 'decisions', label: 'Better decisions', x: 270, y: 743 },
];
const edges: GraphEdge[] = [
  ['edu', 'analytics'],
  ['labour', 'analytics'],
  ['labour', 'sector'],
  ['analytics', 'genai'],
  ['sector', 'decisions'],
  ['genai', 'decisions'],
];
const path = ['edu', 'analytics', 'genai', 'decisions'];

// Crop the frame to the pills, so the drawing's top and bottom edges are the
// first and last node. The page can then align them with the text beside it.
const top = Math.min(...nodes.map((n) => n.y - pill(n.label).hh)) - 1;
const bottom = Math.max(...nodes.map((n) => n.y + pill(n.label).hh)) + 1;
---
<Graph
  class="about-graph"
  {nodes} {edges} {path}
  title="Education data and labour-market signals feed analytics, which powers GenAI products and better decisions."
  viewBox={`0 ${top} ${W} ${bottom - top}`}
  preserveAspectRatio="xMidYMin meet"
/>

<style>
  :global(.about-graph) { width: 100%; height: 100%; max-height: 100%; }
</style>
