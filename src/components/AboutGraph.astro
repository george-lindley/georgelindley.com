---
// The About hero: a labelled causal graph of what George works on.
// Edges draw themselves in once on load (CSS only), highlighted path in accent.
const W = 480, H = 620;
type N = { id: string; label: string; x: number; y: number; hot?: boolean };
const nodes: N[] = [
  { id: 'edu', label: 'Education data', x: 130, y: 90, hot: true },
  { id: 'labour', label: 'Labour-market signals', x: 330, y: 150 },
  { id: 'analytics', label: 'Analytics', x: 200, y: 260, hot: true },
  { id: 'sector', label: 'Sector insight', x: 360, y: 350 },
  { id: 'genai', label: 'GenAI products', x: 170, y: 420, hot: true },
  { id: 'decisions', label: 'Better decisions', x: 270, y: 540, hot: true },
];
const edges: [string, string][] = [
  ['edu', 'analytics'],
  ['labour', 'analytics'],
  ['labour', 'sector'],
  ['analytics', 'genai'],
  ['sector', 'decisions'],
  ['genai', 'decisions'],
];
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const size = (n: N) => ({ hw: n.label.length * 3.9 + 18, hh: 18 });

// Clip a centre-to-centre line to the pill outlines so arrows touch the edge.
function clip(a: N, b: N) {
  const dx = b.x - a.x, dy = b.y - a.y;
  const exit = (n: N) => { const { hw, hh } = size(n); return Math.min(hw / Math.abs(dx || 1e-6), hh / Math.abs(dy || 1e-6)); };
  const s = exit(a) + 0.02, e = exit(b) + 0.045;
  return { x1: a.x + dx * s, y1: a.y + dy * s, x2: b.x - dx * e, y2: b.y - dy * e, angle: (Math.atan2(dy, dx) * 180) / Math.PI };
}
const lines = edges.map(([from, to], i) => {
  const a = byId[from], b = byId[to];
  return { ...clip(a, b), hot: a.hot && b.hot, i };
});
---
<svg class="graph" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="graph-title">
  <title id="graph-title">Education data and labour-market signals feed analytics, which powers GenAI products and better decisions.</title>
  {lines.map((l) => (
    <g class:list={['edge', { hot: l.hot }]} style={`--i:${l.i}`}>
      <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} pathLength="1" />
      <path class="head" d="M0 -5 9 0 0 5z" transform={`translate(${l.x2} ${l.y2}) rotate(${l.angle})`} />
    </g>
  ))}

  {nodes.map((n, i) => {
    const { hw, hh } = size(n);
    return (
      <g class:list={['node', { hot: n.hot }]} style={`--i:${i}`}>
        <rect x={n.x - hw} y={n.y - hh} width={hw * 2} height={hh * 2} rx={hh} />
        <text x={n.x} y={n.y + 4.5} text-anchor="middle">{n.label}</text>
      </g>
    );
  })}
</svg>

<style>
  .graph { width: 100%; height: 100%; max-height: 100%; font-family: var(--font); }
  .edge line { stroke: #c4c4bf; stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 0.7s var(--ease) forwards; animation-delay: calc(0.35s + var(--i) * 0.14s); }
  .edge .head { fill: #c4c4bf; opacity: 0; animation: fade 0.2s linear forwards; animation-delay: calc(0.95s + var(--i) * 0.14s); }
  .edge.hot line { stroke: var(--accent); stroke-width: 2.25; }
  .edge.hot .head { fill: var(--accent); }
  .node { opacity: 0; animation: pop 0.5s var(--ease) forwards; animation-delay: calc(var(--i) * 0.08s); transform-box: fill-box; transform-origin: center; }
  .node rect { fill: var(--paper); stroke: #c4c4bf; stroke-width: 1.25; }
  .node text { fill: var(--ink); font-size: 13px; font-weight: 500; }
  .node.hot rect { fill: var(--accent); stroke: var(--accent); }
  .node.hot text { fill: var(--ink); } /* dark on orange: ~7.6:1; white would fail contrast */
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes pop { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: none; } }
</style>
